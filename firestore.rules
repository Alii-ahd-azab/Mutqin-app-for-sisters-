rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isServerOrAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'herotero13@gmail.com' ||
        request.auth.token.firebase.sign_in_provider == 'custom' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // 1. DEFAULT DENY ALL: Blocks unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. CONNECTION PROBE: Health check endpoint required by Firebase boot lifecycle
    match /test/{testId} {
      allow read, write: if true;
    }

    // 3. USERS: Members & Admins collection
    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if true;
      allow create, update, delete: if isValidId(userId);
    }

    // 4. SETTINGS: Global group memorization settings & daily thoughts
    match /settings/{settingId} {
      allow get: if isValidId(settingId);
      allow list: if true;
      allow write: if isValidId(settingId);
    }

    // 5. REST DAYS: Catch-up & rest days added by supervisor
    match /rest_days/{restDayId} {
      allow get: if isValidId(restDayId);
      allow list: if true;
      allow write: if isValidId(restDayId);
    }

    // 6. RECITATIONS: Mutual recitation records
    match /recitations/{recitationId} {
      allow get: if isValidId(recitationId);
      allow list: if true;
      allow create, update, delete: if isValidId(recitationId);
    }

    // 7. REVISIONS: Daily individual revision logs
    match /revisions/{revisionId} {
      allow get: if isValidId(revisionId);
      allow list: if true;
      allow create, update, delete: if isValidId(revisionId);
    }
  }
}

